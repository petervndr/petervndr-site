---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  article?: {
    publishedTime: string;
    section: string;
    author: string;
  };
}

const { title, description, canonicalURL, ogImage = '/images/peter-vander-wall-og.jpg', article } = Astro.props;
const siteURL = 'https://petervndr.com';
const fullCanonical = canonicalURL ? `${siteURL}${canonicalURL}` : siteURL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage?.startsWith('http') ? ogImage : `${siteURL}${ogImage}`} />
    <meta property="og:site_name" content="Peter Vander Wall" />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:section" content={article.section} />}
    {article && <meta property="article:author" content={article.author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@petervndr" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage?.startsWith('http') ? ogImage : `${siteURL}${ogImage}`} />

    <meta name="theme-color" content="#6800FC" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Global Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://petervndr.com/#website",
      "name": "Peter Vander Wall",
      "alternateName": "petervndr",
      "url": "https://petervndr.com",
      "description": "Marketing strategist for accounting firm owners. Founder of Social Club Studios and Scale Your Accounting Firm.",
      "publisher": {
        "@id": "https://petervndr.com/about#person"
      }
    }
    </script>

    <!-- Hyros tag -->
    <script is:inline>
    var head = document.head;
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = "https://t.socialclubstudios.com/v1/lst/universal-script?ph=7b938cc596620ef0c1be7fb4d6eafb7774f19216f3982d13d130f36ebcc99d05&tag=!clicked&ref_url=" + encodeURI(document.URL) ;
    head.appendChild(script);
    </script>

    <slot name="head" />
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">Peter Vander Wall</a>
        <button class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/blog">Free Content</a>
          <a href="/about">About</a>
          <a href="/contact" class="nav-cta">Contact</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-links">
          <a href="https://www.youtube.com/@petervndr" target="_blank" rel="noopener">YouTube</a>
          <a href="https://www.linkedin.com/in/petervanderwall/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.instagram.com/petervndr/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://twitter.com/petervndr" target="_blank" rel="noopener">X</a>
          <a href="https://podcasts.apple.com/us/podcast/scale-your-accounting-firm-with-peter-vander-wall/id1726654302" target="_blank" rel="noopener">Podcast</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Peter Vander Wall. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const nav = document.querySelector('.nav');
      const hero = document.querySelector('.hero, .about-hero, .contact-hero, .blog-hero, .post-hero');

      if (!hero) {
        nav.classList.add('nav-light');
      } else {
        const update = () => {
          if (window.scrollY > 0) {
            nav.classList.add('nav-light');
          } else {
            nav.classList.remove('nav-light');
          }
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      // Hamburger menu toggle
      const hamburger = document.querySelector('.nav-hamburger');
      const navLinks = document.querySelector('.nav-links');
      hamburger.addEventListener('click', () => {
        const open = nav.classList.toggle('nav-open');
        hamburger.setAttribute('aria-expanded', open);
        if (open) {
          nav.classList.add('nav-light');
        } else if (hero && window.scrollY === 0) {
          nav.classList.remove('nav-light');
        }
      });
      // Close menu when a link is tapped
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('nav-open');
          hamburger.setAttribute('aria-expanded', 'false');
          if (hero && window.scrollY === 0) {
            nav.classList.remove('nav-light');
          }
        });
      });
    </script>
    <Analytics />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-bg: #0a0a0f;
    --color-surface: #12121a;
    --color-border: #2a2a3a;
    --color-border-strong: #6800FC;
    --color-text: #d8d8e8;
    --color-text-muted: #8585a0;
    --color-accent: #6800FC;
    --color-accent-light: #9b4dff;
    --color-accent-glow: rgba(104, 0, 252, 0.15);
    --color-white: #ffffff;
    --color-orange: #FF6240;
    --font-heading: 'Merriweather', Georgia, serif;
    --font-body: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --max-width: 1000px;
  }

  html {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    background: #f5f5f5;
    color: #333333;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    color: #1a1a2e;
    line-height: 1.25;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--color-accent-light);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Nav — default: fully transparent over dark hero */
  .nav {
    padding: 1.25rem 2rem;
    position: sticky;
    top: 0;
    background: transparent;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }

  /* Nav — light mode (over #f5f5f5 content) */
  .nav.nav-light {
    background: rgba(245, 245, 245, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e0e0e8;
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--color-white);
    letter-spacing: -0.01em;
    transition: color 0.3s;
  }

  .nav-logo:hover {
    color: var(--color-accent-light);
  }

  .nav.nav-light .nav-logo {
    color: #1a1a2e;
  }

  .nav.nav-light .nav-logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--color-accent-light);
  }

  .nav.nav-light .nav-links a {
    color: #565A7C;
  }

  .nav.nav-light .nav-links a:hover {
    color: var(--color-accent);
  }

  .nav-cta {
    background: var(--color-accent) !important;
    color: #ffffff !important;
    padding: 10px 20px !important;
    border-radius: 4px;
    font-size: 0.7rem !important;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: background 0.25s, transform 0.25s;
  }

  .nav-cta:hover {
    background: var(--color-accent-light) !important;
    color: #ffffff !important;
    transform: translateY(-1px);
  }

  /* Footer */
  .footer {
    border-top: 3px solid var(--color-accent);
    padding: 3rem 2rem;
    margin-top: 0;
    background: #121212;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-accent-light);
  }

  .footer-copy {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  /* Hamburger button — hidden on desktop */
  .nav-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 110;
    flex-direction: column;
    gap: 5px;
  }

  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-muted);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s, background 0.3s;
  }

  .nav.nav-light .nav-hamburger span {
    background: #565A7C;
  }

  /* Animate to X when open */
  .nav.nav-open .nav-hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav.nav-open .nav-hamburger span:nth-child(2) {
    opacity: 0;
  }
  .nav.nav-open .nav-hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 600px) {
    .nav {
      padding: 1rem 1.25rem;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 0;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.25s, transform 0.25s;
    }

    .nav.nav-light .nav-links {
      background: rgba(245, 245, 245, 0.98);
      border-bottom: 1px solid #e0e0e8;
    }

    .nav.nav-open .nav-links {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-links a {
      font-size: 0.85rem;
      padding: 0.75rem 2rem;
      width: 100%;
      text-align: center;
    }

    .nav-cta {
      margin-top: 0.5rem;
      width: auto !important;
      display: inline-block !important;
    }

    .footer-links {
      gap: 1rem;
    }
  }
</style>
