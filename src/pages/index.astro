---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://petervndr.com/#service",
  "name": "Peter Vander Wall — Marketing for Accounting Firms",
  "alternateName": "The Accountant's Marketing Guy",
  "url": "https://petervndr.com",
  "image": "https://petervndr.com/images/peter-vander-wall.jpg",
  "description": "Marketing strategist helping accounting firm owners build predictable client acquisition systems — ad funnels, VSLs, messaging frameworks, and CRM builds.",
  "founder": {
    "@id": "https://petervndr.com/about#person"
  },
  "areaServed": {
    "@type": "Country",
    "name": "US"
  },
  "serviceType": [
    "Marketing Strategy for Accounting Firms",
    "Facebook Advertising for Accountants",
    "Sales Funnel Development",
    "Video Sales Letters",
    "Lead Generation for CPA Firms",
    "CRM Implementation",
    "Messaging & Positioning"
  ],
  "knowsAbout": [
    "Accounting firm marketing",
    "Client acquisition systems",
    "Tax planning firm growth",
    "Bookkeeping firm scaling"
  ],
  "sameAs": [
    "https://socialclubstudios.com",
    "https://joinsyaf.com",
    "https://www.youtube.com/@petervndr",
    "https://www.linkedin.com/in/petervanderwall/"
  ]
};
---

<BaseLayout
  title="Peter Vander Wall — The Accountant's Marketing Guy"
  description="Founder of Social Club Studios and Scale Your Accounting Firm. Helping accounting firm owners build predictable revenue since 2021."
  canonicalURL="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  </Fragment>
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-label">The Accountant's Marketing Guy</p>
        <h1>Peter Vander Wall</h1>
        <ul class="hero-credentials">
          <li>Founder of <a href="https://socialclubstudios.com" target="_blank" rel="noopener">Social Club Studios</a> &amp; <a href="https://joinsyaf.com" target="_blank" rel="noopener">Scale Your Accounting Firm</a></li>
          <li>Helping accounting firm owners build predictable revenue since 2021</li>
        </ul>
        <div class="hero-image-mobile">
          <img
            src="/images/peter-vander-wall-mobile.jpg"
            alt="Peter Vander Wall at his desk"
            width="1500"
            height="1000"
          />
        </div>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
        </div>
      </div>
      <div class="hero-image">
        <img
          src="/images/peter-vander-wall.jpg"
          alt="Peter Vander Wall — Marketing strategist for accounting firms"
          width="400"
          height="400"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <h2>What I Do</h2>
    <div class="cards">
      <div class="card reveal">
        <h3>Marketing for Accounting Firms</h3>
        <p>Ad funnels, VSLs, messaging, and lead gen systems built specifically for accounting firm owners who want to grow beyond referrals.</p>
        <a href="https://socialclubstudios.com" target="_blank" rel="noopener" class="card-cta">Learn More &rarr;</a>
      </div>
      <div class="card reveal reveal-delay-1">
        <h3>Advisory Groups</h3>
        <p>Scale Your Accounting Firm — an advisory service for accounting firm owners ready to scale with proven marketing and sales frameworks.</p>
        <a href="https://joinsyaf.com" target="_blank" rel="noopener" class="card-cta">Learn More &rarr;</a>
      </div>
      <div class="card reveal reveal-delay-2">
        <h3>Education &amp; Content</h3>
        <p>Host of the Scale Your Accounting Firm Podcast, sharing marketing strategies &amp; growth tactics for accounting firm owners.</p>
        <a href="https://www.youtube.com/@petervndr" target="_blank" rel="noopener" class="card-cta">Watch Now &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Case Studies</h2>
    <div class="results">
      <div class="result reveal">
        <span class="result-number">Scaled to $3M/yr in 3 years</span>
        <span class="result-label">Ryan Bakke, Tax Strategy 365</span>
        <span class="result-detail">Real estate CPA firm offering tax strategy for real estate investors. Scaled from $100k in 2021 to $3M in 2024, built a 50k+ online audience, and built one of the best-known education brands in the real estate space.</span>
        <a href="https://youtu.be/gO7lH1motAo" target="_blank" rel="noopener" class="result-cta">Watch Case Study &rarr;</a>
      </div>
      <div class="result reveal reveal-delay-1">
        <span class="result-number">Added $130k ARR in under 6 weeks.</span>
        <span class="result-label">Brock Hartzler, Pro Mover Accounting</span>
        <span class="result-detail">Bookkeeping &amp; tax prep firm for local moving companies. Launched ads in Jan 2025 and added $130k in ARR from less than $10k in adspend. This firm went on to scale from $34k to $92k MRR by the end of 2025.</span>
        <a href="https://youtu.be/U6QCPbCaioE" target="_blank" rel="noopener" class="result-cta">Watch Case Study &rarr;</a>
      </div>
      <div class="result reveal reveal-delay-2">
        <span class="result-number">Closed $400k in one month</span>
        <span class="result-label">Daniel Koehler, GTG Tax Planning</span>
        <span class="result-detail">Tax planning firm for high earners in the tech industry. Closed over $100k of new tax planning engagements their first 3 months running ads, and less than 6 months in they did a record-breaking $400k of new sales in a 30-day period.</span>
        <a href="https://youtu.be/58xQRty7ZBc" target="_blank" rel="noopener" class="result-cta">Watch Case Study &rarr;</a>
      </div>
    </div>
    <div class="results-cta"><a href="/about" class="btn btn-primary">See More</a></div>
  </section>

  <section class="section">
    <div class="testimonials-header">
      <h2>What Clients Say</h2>
      <div class="testimonials-nav">
        <button class="testimonials-arrow testimonials-prev" aria-label="Previous">&larr;</button>
        <button class="testimonials-arrow testimonials-next" aria-label="Next">&rarr;</button>
      </div>
    </div>
    <div class="testimonials-wrapper reveal">
    <div class="testimonials">
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;Accelerated our growth years, if not a decade ahead of where we'd be.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/daniel koehler.jpg" alt="Daniel Koehler" />
          <div>
            <p class="testimonial-author">Daniel Koehler</p>
            <p class="testimonial-company">GTG Tax Planning</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;I would recommend them to anyone who is looking to scale a firm to millions.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/ryan bakke.jpg" alt="Ryan Bakke" />
          <div>
            <p class="testimonial-author">Ryan Bakke</p>
            <p class="testimonial-company">Tax Strategy 365</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;We had to pause ads because we couldn't onboard clients fast enough.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/brock hartzler.jpeg" alt="Brock Hartzler" />
          <div>
            <p class="testimonial-author">Brock Hartzler</p>
            <p class="testimonial-company">ProMover Accounting</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;The fastest start we've ever had on an account.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/brian mayoral.jpg" alt="Brian Mayoral" />
          <div>
            <p class="testimonial-author">Brian Mayoral</p>
            <p class="testimonial-company">WeSellUp</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;Peter is the marketing EXPERT for accounting firms. Helped me breakthrough a growth plateau I've had for years.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/ryan roe.jpg" alt="Ryan Roe" />
          <div>
            <p class="testimonial-author">Ryan Roe</p>
            <p class="testimonial-company">P1 Tax Advisors</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;I could literally see our leads sitting at the kitchen table thinking those exact things.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/rudy rodriguez.png" alt="Rudy Rodriguez" />
          <div>
            <p class="testimonial-author">Rudy Rodriguez</p>
            <p class="testimonial-company">Freedom From Accounting</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;The 1-1 call with Peter felt like a big unlock for me. Top notch operation.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/nick sailer.jpg" alt="Nick Sailer" />
          <div>
            <p class="testimonial-author">Nick Sailer</p>
            <p class="testimonial-company">Sailer Business</p>
          </div>
        </div>
      </div>
      <div class="testimonial">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-quote">&ldquo;Very helpful getting me in the right direction with marketing and sales.&rdquo;</p>
        <div class="testimonial-footer">
          <img class="testimonial-avatar" src="/testimonials/charles harris.jpg" alt="Charles Harris" />
          <div>
            <p class="testimonial-author">Charles Harris</p>
            <p class="testimonial-company">Charles Harris CPA</p>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <section class="section-cta">
    <div class="section-cta-inner reveal">
      <h2>Get in Touch</h2>
      <div class="typeform-wrap" data-tf-live="01KK5NYATD4V9TEKPTC4ZC0VEV"></div>
      <script is:inline src="//embed.typeform.com/next/embed.js"></script>
      <div class="cta-social">
        <a href="https://www.youtube.com/@petervndr" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.linkedin.com/in/petervanderwall/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://www.instagram.com/petervndr/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://twitter.com/petervndr" target="_blank" rel="noopener">X</a>
        <a href="https://www.tiktok.com/@petervndr" target="_blank" rel="noopener">TikTok</a>
        <a href="https://www.skool.com/syaf" target="_blank" rel="noopener">Skool</a>
        <a href="https://podcasts.apple.com/us/podcast/scale-your-accounting-firm-with-peter-vander-wall/id1726654302" target="_blank" rel="noopener">Podcast</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — dark gradient, pulled up behind transparent nav */
  .hero {
    margin-top: -74px;
    padding: calc(5rem + 74px) 2rem 4rem;
    background: #121212;
  }

  .hero-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  .hero-text {
    flex: 1;
  }

  .hero-label {
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 3.25rem;
    font-weight: 900;
    line-height: 1.15;
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .hero-credentials {
    list-style: none;
    margin-bottom: 2rem;
  }

  .hero-credentials li {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.9;
  }

  .hero-credentials a {
    color: var(--color-accent-light);
  }

  .hero-credentials a:hover {
    color: var(--color-white);
  }

  .hero-image-mobile {
    display: none;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all 0.25s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-white);
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-light);
    border-color: var(--color-accent-light);
    color: var(--color-white);
    transform: translateY(-1px);
  }

  .btn-secondary {
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.9);
    background: transparent;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    color: var(--color-white);
    transform: translateY(-1px);
  }

  .hero-image {
    flex-shrink: 0;
  }

  .hero-image img {
    width: 300px;
    height: 300px;
    border-radius: 8px;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.15);
  }

  /* Content sections — light background */
  .section {
    padding: 4rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
    border-bottom: 1px solid #e0e0e8;
  }

  .section:last-child {
    border-bottom: none;
  }

  .section h2 {
    font-size: 2rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-bottom: 2rem;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .section h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--color-accent);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e0e0e8;
    border-top: 3px solid var(--color-accent);
    border-radius: 6px;
    padding: 2rem 1.75rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(104, 0, 252, 0.08);
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-bottom: 0.75rem;
  }

  .card p {
    font-size: 0.92rem;
    color: #565A7C;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .card-cta {
    margin-top: auto;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    transition: color 0.2s;
  }

  .card-cta:hover {
    color: var(--color-accent-light);
  }

  .results {
    display: grid;
    gap: 1.5rem;
  }

  .result {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e0e0e8;
    border-left: 4px solid var(--color-accent);
    border-radius: 6px;
    padding: 1.5rem 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .result:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(104, 0, 252, 0.08);
  }

  .result-number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 900;
    color: #1a1a2e;
  }

  .result-label {
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-top: 0.35rem;
  }

  .result-detail {
    font-size: 0.85rem;
    color: #565A7C;
    margin-top: 0.35rem;
  }

  .result-cta {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .result-cta:hover {
    color: var(--color-accent-light);
  }

  .results-cta {
    margin-top: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }

  /* Testimonials */
  .testimonials-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .testimonials-header h2 {
    margin-bottom: 0;
  }

  .testimonials-nav {
    display: flex;
    gap: 0.5rem;
  }

  .testimonials-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #e0e0e8;
    background: #ffffff;
    color: #1a1a2e;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .testimonials-arrow:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .testimonials-wrapper {
    position: relative;
    overflow: hidden;
  }

  .testimonials-wrapper::before,
  .testimonials-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }

  .testimonials-wrapper::before {
    left: 0;
    background: linear-gradient(to right, #f5f5f5, transparent);
  }

  .testimonials-wrapper::after {
    right: 0;
    background: linear-gradient(to left, #f5f5f5, transparent);
  }

  .testimonials {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  .testimonials::-webkit-scrollbar {
    display: none;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e0e0e8;
    border-radius: 6px;
    padding: 2rem 1.75rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    min-width: 300px;
    max-width: 340px;
    flex-shrink: 0;

  }

  .testimonial-stars {
    color: #00b67a;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .testimonial-quote {
    font-size: 1.1rem;
    color: #1a1a2e;
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .testimonial-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .testimonial-avatar {
    width: 40px;
    min-width: 40px;
    height: 40px;
    min-height: 40px;
    border-radius: 50%;
    background: #1a1a2e;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    object-fit: cover;
    flex-shrink: 0;
    flex-shrink: 0;
  }

  .testimonial-author {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1a1a2e;
  }

  .testimonial-company {
    font-size: 0.78rem;
    color: #565A7C;
    margin-top: 0.15rem;
  }

  /* CTA Section */
  .section-cta {
    background: #f5f5f5;
    padding: 4rem 2rem;
    text-align: center;
  }

  .section-cta-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .section-cta h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .section-cta h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--color-accent);
  }

  .section-cta p {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .typeform-wrap {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .cta-social {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta-social a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid #ccc;
    border-radius: 4px;
    color: #666;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: all 0.25s;
  }

  .cta-social a:hover {
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
  }

  @media (max-width: 700px) {
    .hero {
      padding: calc(3rem + 40px) 1.25rem 2.5rem;
    }

    .hero-content {
      flex-direction: column;
      text-align: left;
      gap: 2rem;
    }

    h1 {
      font-size: 2.25rem;
    }

    .hero-image {
      display: none;
    }

    .hero-image-mobile {
      display: block;
      margin-bottom: 1.5rem;
    }

    .hero-image-mobile img {
      width: 100%;
      height: auto;
      border-radius: 8px;
    }

    .section {
      padding: 3rem 1.25rem;
    }

    .section h2 {
      font-size: 1.6rem;
    }

    .section-cta {
      padding: 3rem 1.25rem;
    }

    .section-cta h2 {
      font-size: 1.6rem;
    }

    .testimonials-wrapper::before,
    .testimonials-wrapper::after {
      display: none;
    }
  }

  /* Scroll reveal animations */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
</style>

<script>
  const track = document.querySelector('.testimonials');
  const prev = document.querySelector('.testimonials-prev');
  const next = document.querySelector('.testimonials-next');

  const cards = Array.from(track.querySelectorAll('.testimonial'));
  const gap = 24;
  const cardWidth = cards[0].offsetWidth + gap;
  const setWidth = cards.length * cardWidth;

  // Prepend + append clones so we have 3 sets: [clones][originals][clones]
  cards.forEach(card => track.appendChild(card.cloneNode(true)));
  const frag = document.createDocumentFragment();
  cards.forEach(card => frag.appendChild(card.cloneNode(true)));
  track.insertBefore(frag, track.firstChild);

  // Start at the middle set (the originals)
  track.style.scrollBehavior = 'auto';
  track.scrollLeft = setWidth;
  track.style.scrollBehavior = 'smooth';

  function resetIfNeeded() {
    const pos = track.scrollLeft;
    // Scrolled into the appended clones — jump back to originals
    if (pos >= setWidth * 2 - cardWidth / 2) {
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = pos - setWidth;
      track.style.scrollBehavior = 'smooth';
    }
    // Scrolled into the prepended clones — jump forward to originals
    if (pos <= cardWidth / 2) {
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = pos + setWidth;
      track.style.scrollBehavior = 'smooth';
    }
  }

  prev.addEventListener('click', () => {
    track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    setTimeout(resetIfNeeded, 400);
  });

  next.addEventListener('click', () => {
    track.scrollBy({ left: cardWidth, behavior: 'smooth' });
    setTimeout(resetIfNeeded, 400);
  });

  // Scroll reveal animations
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  reveals.forEach(el => observer.observe(el));
</script>
