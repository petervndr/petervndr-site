---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get related posts (same category, excluding current)
const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => b.data.viewCount - a.data.viewCount)
  .slice(0, 3);

// Cross-category posts: share at least one tag, different category
const crossCategory = post.data.tags
  ? allPosts
      .filter(p =>
        p.id !== post.id &&
        p.data.category !== post.data.category &&
        p.data.tags?.some(t => post.data.tags?.includes(t))
      )
      .sort((a, b) => b.data.viewCount - a.data.viewCount)
      .slice(0, 3)
  : [];

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function parseDuration(iso: string): string {
  const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
  if (!match) return '';
  const h = parseInt(match[1] || '0');
  const m = parseInt(match[2] || '0');
  if (h > 0) return `${h}h ${m}m`;
  return `${m} min`;
}

const wordCount = post.body ? post.body.split(/\s+/).length : 0;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.thumbnail,
  "datePublished": post.data.date,
  "dateModified": post.data.date,
  "inLanguage": "en-US",
  "articleSection": post.data.categoryLabel,
  "wordCount": wordCount,
  "author": {
    "@id": "https://petervndr.com/about#person"
  },
  "publisher": {
    "@id": "https://petervndr.com/about#person"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://petervndr.com/blog/${post.id}`
  },
  "isPartOf": {
    "@id": "https://petervndr.com/#website"
  },
  "video": {
    "@type": "VideoObject",
    "name": post.data.title,
    "description": post.data.description,
    "thumbnailUrl": post.data.thumbnail,
    "uploadDate": post.data.date,
    "duration": post.data.duration,
    "embedUrl": `https://www.youtube.com/embed/${post.data.youtubeId}`,
    "contentUrl": `https://www.youtube.com/watch?v=${post.data.youtubeId}`
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://petervndr.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Free Content",
      "item": "https://petervndr.com/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.categoryLabel,
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": post.data.title
    }
  ]
};

const faqSchema = post.data.faq && post.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<BaseLayout
  title={`${post.data.title} — Peter Vander Wall`}
  description={post.data.description}
  canonicalURL={`/blog/${post.id}`}
  ogImage={post.data.thumbnail}
  article={{
    publishedTime: post.data.date,
    section: post.data.categoryLabel,
    author: 'https://petervndr.com/about',
  }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <article class="post">
    <section class="post-hero">
      <div class="post-hero-inner">
        <a href="/blog" class="post-back">&larr; Back to Free Content</a>
        <span class="post-category">{post.data.categoryLabel}</span>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span>{formatDate(post.data.date)}</span>
          {post.data.duration && <span>{parseDuration(post.data.duration)} watch</span>}
          {post.data.viewCount > 0 && <span>{post.data.viewCount.toLocaleString()} views</span>}
        </div>
      </div>
    </section>

    <section class="post-body">
      <div class="post-video">
        <div class="video-wrapper">
          <iframe
            src={`https://www.youtube.com/embed/${post.data.youtubeId}`}
            title={post.data.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="post-content">
        <Content />
      </div>

      <div class="post-cta">
        <h3>Want help scaling your firm?</h3>
        <p>If you're an accounting firm owner looking to build a predictable client acquisition system, let's talk.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>

      {related.length > 0 && (
        <div class="related-posts">
          <h3>Related Posts</h3>
          <div class="related-grid">
            {related.map(r => (
              <a href={`/blog/${r.id}`} class="related-card">
                <img src={r.data.thumbnail} alt={r.data.title} loading="lazy" />
                <span class="related-title">{r.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {crossCategory.length > 0 && (
        <div class="related-posts">
          <h3>More on This Topic</h3>
          <div class="related-grid">
            {crossCategory.map(r => (
              <a href={`/blog/${r.id}`} class="related-card">
                <img src={r.data.thumbnail} alt={r.data.title} loading="lazy" />
                <span class="related-title">{r.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .post-hero {
    background: #121212;
    margin-top: -74px;
    padding: calc(3rem + 74px) 2rem 3rem;
  }

  .post-hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-back {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.25rem;
    transition: color 0.2s;
  }

  .post-back:hover {
    color: var(--color-accent);
  }

  .post-category {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .post-hero h1 {
    font-size: 2.25rem;
    color: var(--color-white);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .post-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .post-video {
    margin-bottom: 2.5rem;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #333;
  }

  .post-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(strong) {
    color: #1a1a2e;
  }

  .post-content :global(a) {
    color: var(--color-accent);
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: #f8f8fc;
    border-radius: 0 6px 6px 0;
    font-style: italic;
    color: #555;
  }

  .post-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: #f5f5f5;
    border-radius: 8px;
    text-align: center;
  }

  .post-cta h3 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-bottom: 0.5rem;
  }

  .post-cta p {
    font-size: 0.92rem;
    color: #565A7C;
    margin-bottom: 1.25rem;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all 0.25s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-white);
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-light);
    border-color: var(--color-accent-light);
    transform: translateY(-1px);
  }

  .related-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e0e0e8;
  }

  .related-posts h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 900;
    color: #1a1a2e;
    margin-bottom: 1rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .related-card {
    text-decoration: none;
    transition: transform 0.2s;
  }

  .related-card:hover {
    transform: translateY(-2px);
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }

  .related-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .post-hero {
      padding: calc(1.5rem + 74px) 1.25rem 2rem;
    }

    .post-hero h1 {
      font-size: 1.6rem;
    }

    .post-meta {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .post-body {
      padding: 1.5rem 1.25rem 3rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
